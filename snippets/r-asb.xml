<?xml version="1.0" encoding="UTF-8"?>
<manifest>
<!-- Untrack projects forked by us -->
  <remove-project name="LineageOS/android_build" />
  <remove-project name="LineageOS/android_frameworks_av" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <remove-project name="LineageOS/android_system_bt" />
  <remove-project name="LineageOS/android_vendor_qcom_opensource_system_bt" />
<!-- Track project forks -->
  <project path="build/make" name="LineageOS-R-ASB/build" groups="pdk" >
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="frameworks/av" name="LineageOS-R-ASB/frameworks_av" groups="pdk" />
  <project path="frameworks/base" name="LineageOS-R-ASB/frameworks_base" groups="pdk-cw-fs,pdk-fs" />
  <project path="packages/apps/Settings" name="LineageOS-R-ASB/packages_apps_Settings" groups="pdk-fs" />
  <project path="system/bt" name="LineageOS-R-ASB/system_bt" groups="pdk" />
  <project path="vendor/qcom/opensource/commonsys/system/bt" name="LineageOS-R-ASB/vendor_qcom_opensource_system_bt" groups="qcom,pdk-qcom"/>
</manifest>
